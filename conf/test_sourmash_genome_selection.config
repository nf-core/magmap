/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run nf-core/magmap -profile test_sourmash_genome_selection,<docker/singularity> --outdir <OUTDIR>

    Base profile for tests/sourmash_genome_selection.nf.test, which covers Sourmash-driven
    genome selection outside of species_preference (see tests/species_preference.nf.test
    for that): the default species_preference='all' (no filtering) with local+remote
    genomes mixed, a remote-only scenario (no --genomeinfo), and multiple comma-separated
    --indexes files -- each combined with genomeset_mode (joint/sample) where relevant.
----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
    // Prokka peaks around 450MB on these small test genomes, well under the
    // resourceLimits ceiling above -- give it its own tight reservation so
    // more Prokka jobs can run in parallel without starving other processes
    // of memory.
    withName: PROKKA {
        memory = { 2.GB * task.attempt }
    }
}

params {
    config_profile_name        = 'Test profile for Sourmash-driven genome selection'
    config_profile_description = 'Minimal test dataset (archaeal genomes with duplicated species) to check Sourmash genome selection: all genomes kept, remote-only, and multiple index files'

    // Input data
    input               = params.pipelines_testdata_base_path + 'magmap/samplesheets/archaeal_duplicate_genomes_per_species.csv'
    indexes             = params.pipelines_testdata_base_path + 'magmap/testdata/archaeal_duplicates.index.sbt.zip'
    genomeinfo          = params.pipelines_testdata_base_path + 'magmap/testdata/archaeal_duplicates.genomes.csv'
    sourmash_ksize      = 31
    // Excludes tmRNA: Prokka finds none in this dataset, and featureCounts treats "no
    // features of this type" as a fatal error rather than returning zero counts.
    features            = 'CDS,rRNA,tRNA'
    gtdb_metadata       = "https://data.gtdb.aau.ecogenomic.org/releases/release226/226.0/ar53_metadata_r226.tsv.gz"
    checkm_metadata     = params.pipelines_testdata_base_path + 'magmap/testdata/archaeal_duplicates.checkm.tsv,' + params.pipelines_testdata_base_path + 'magmap/testdata/archaeal_duplicates.checkm2.tsv'
    gtdbtk_metadata     = params.pipelines_testdata_base_path + 'magmap/testdata/archaeal_duplicates.gtdbtk.tsv'

    // Sourmash option
    skip_sourmash          = false
    skip_trimming          = true
    sourmash_save_sourmash = true
}
