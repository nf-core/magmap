/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        enabled: false
    ]

    withName: FASTQC {
        ext.args = '--quiet'
        publishDir = [
            [
                path: { "${params.outdir}/fastqc" },
                mode: params.publish_dir_mode,
                pattern: "*.html"
            ]
        ]
    }

    withName: TRIMGALORE {
        ext.args = [
            '--fastqc',
            params.trim_reads > 0 ? "--nextseq ${params.trim_reads}" : ''
        ].join(' ').trim()
        publishDir = [
            [
                path: { "${params.outdir}/trimgalore/fastqc" },
                mode: params.publish_dir_mode,
                pattern: "*.html"
            ],
            [
                path: { "${params.outdir}/trimgalore" },
                mode: params.publish_dir_mode,
                pattern: "*.txt"
            ]
        ]
    }

    withName: CAT_MANY {
        publishDir = [
            path: { "${params.outdir}/concatenate" },
            mode: params.publish_dir_mode,
            pattern: '*.gz',
            enabled: params.save_concatenated_genomes
        ]
    }

    withName: GFFREAD {
        ext.args = '-y'
    }

    withName: CAT_FAA {
        publishDir = [
            path: { "${params.outdir}/proteins" },
            mode: params.publish_dir_mode,
            pattern: '*.gz'
        ]
    }

    withName: GENOMES2ORFS {
        ext.prefix = "magmap"
        publishDir = [
            path: { "${params.outdir}/summary_tables" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'BAM_SORT_STATS_SAMTOOLS:*' {
        publishDir = [
            enabled: false
        ]
    }

    withName: WGET_GENOME {
        storeDir = { "${params.genome_store_dir}" }
        errorStrategy = { task.attempt < 5 ? 'retry' : 'ignore' }
        maxRetries = 5
    }

    withName: PROKKAGFF2TSV {
        publishDir = [
            enabled: false
        ]
    }

    withName: PROKKA {
        ext.args = '--centre X --compliant'
        storeDir = { "${params.prokka_store_dir}" }
    }

    withName: BAKTA_BAKTADBDOWNLOAD {
        storeDir = { "${params.bakta_db}" }
    }

    withName: BAKTA_BAKTA {
        // Bakta's default --locus ("contig") and --locus-tag (truncated hash) collide across
        // genomes, which breaks the shared BBMap index and FeatureCounts run. A hash of the
        // accno is a valid prefix: Bakta rejects prefixes over 20 characters or outside
        // [A-Za-z0-9_-], and local accnos are arbitrary text.
        ext.args = {
            def locus = java.security.MessageDigest.getInstance('SHA-256')
                .digest(meta.id.bytes)
                .encodeHex()
                .toString()
                .substring(0, 20)
                .toUpperCase()
            "--locus ${locus} --locus-tag ${locus}"
        }
        storeDir = { "${params.bakta_store_dir}" }
    }

    withName: CATPROKKATSVS {
        publishDir = [
            path: { "${params.outdir}/summary_tables" },
            mode: params.publish_dir_mode,
            pattern: "*.prokka-annotations.tsv.gz"
        ]
    }

    withName: 'SAMPLE_SKETCH' {
        ext.prefix = { "${meta.id}" }
        ext.args = "rna --param-string k=${params.sourmash_ksize}"
        // *.sig signatures are large intermediate files and are never published
    }

    withName: 'GENOME_SKETCH' {
        ext.args = "rna --param-string k=${params.sourmash_ksize}"
        // *.sig signatures are large intermediate files and are never published
    }

    withName: 'GENOME_INDEX' {
        ext.prefix = "magmap"
        publishDir = [
            path: { "${params.outdir}/sourmash" },
            mode: params.publish_dir_mode,
            enabled: params.sourmash_save_sourmash
        ]
    }

    withName: 'SOURMASH_GATHER' {
        ext.prefix = { "${meta.id}_${meta2.id}" }
        ext.args = '--threshold-bp "50"'
        publishDir = [
            path: { "${params.outdir}/sourmash" },
            mode: params.publish_dir_mode,
            pattern: "*.csv.gz",
            enabled: params.sourmash_save_sourmash
        ]
        // *.sig.zip outputs are large intermediate files and are never published
    }

    withName: BBMAP_INDEX {
        label = 'process_high_memory'
        publishDir = [
            [
                path: { "${params.outdir}/bbmap/" },
                mode: params.publish_dir_mode,
                pattern: "*",
                enabled: params.bbmap_save_index
            ]
        ]
    }

    // BBMap is used instead of Bowtie2, which failed to index a soil metagenome in
    // Bushnell's benchmark (LBNL-7065E, 2014, https://www.osti.gov/biblio/1241166).
    // The ambig= option also controls how multi-mapping reads are resolved.
    withName: BBMAP_ALIGN {
        label = "process_high_memory"
        ext.prefix = { "${meta.id}" }
        ext.args = { "trimreaddescriptions=t pigz=t minid=${params.bbmap_minid} ambig=${params.bbmap_ambiguous}" }
        publishDir = [
            [
                path: { "${params.outdir}/bbmap/bam" },
                mode: params.publish_dir_mode,
                pattern: "*.bam",
                enabled: params.bbmap_save_bam
            ],
            [
                path: { "${params.outdir}/bbmap/logs" },
                mode: params.publish_dir_mode,
                pattern: "*.log"
            ]
        ]
    }

    withName: SAMTOOLS_SORT {
        ext.prefix = { "${meta.id}.sorted" }
        publishDir = [
            pattern: "*.bam",
            mode: params.publish_dir_mode,
            enabled: false
        ]
    }

    withName: SAMTOOLS_INDEX {
        publishDir = [
            pattern: "*.bai",
            mode: params.publish_dir_mode,
            enabled: false
        ]
    }

    withName: SAMTOOLS_STATS {
        publishDir = [
            path: { "${params.outdir}/samtools" },
            pattern: "*.stats",
            mode: params.publish_dir_mode,
            enabled: true
        ]
    }

    withName: SAMTOOLS_FLAGSTAT {
        publishDir = [
            path: { "${params.outdir}/samtools" },
            pattern: "*.flagstat",
            mode: params.publish_dir_mode,
            enabled: true
        ]
    }

    withName: SAMTOOLS_IDXSTATS {
        publishDir = [
            path: { "${params.outdir}/samtools" },
            pattern: "*.idxstats",
            mode: params.publish_dir_mode,
            enabled: true
        ]
    }

    withName: '.*:FEATURECOUNTS' {
        ext.args = { "-g ID -t ${meta.feature} -F gtf -M ${params.featurecounts_fraction ? '--fraction' : ''} " }
        ext.prefix = { "${meta.id}" }
        publishDir = [
            path: { "${params.outdir}/featurecounts" },
            mode: params.publish_dir_mode,
            pattern: "*.featureCounts.*"
        ]
    }

    withName: CUSTOM_COLLECTFEATURECOUNTS {
        ext.prefix = { "magmap.${meta.id}" }
    }

    withName: TIDYVERSE_JOINFEATURECOUNTSACCNO {
        ext.prefix = { "magmap.${meta.id}" }
        publishDir = [
            path: { "${params.outdir}/summary_tables" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: TIDYVERSE_JOINMETADATA {
        ext.prefix = "magmap"
        publishDir = [
            path: { "${params.outdir}/summary_tables" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: CUSTOM_COLLECTSTATS {
        ext.prefix = "magmap"
        publishDir = [
            path: { "${params.outdir}/summary_tables" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: COLLECT_GENOMESELECTION {
        ext.prefix = "magmap"
        publishDir = [
            path: { "${params.outdir}/summary_tables" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> (filename.equals('versions.yml') || filename.endsWith('_mqc.tsv')) ? null : filename }
        ]
    }

    withName: DUCKDB_TABLE2PARQUET {
        publishDir = [
            path: { "${params.outdir}/summary_tables" },
            mode: params.publish_dir_mode,
            pattern: "*.parquet"
        ]
    }

    withName: CUSTOM_DUMPSOFTWAREVERSIONS {
        publishDir = [
            path: { "${params.outdir}/pipeline_info" },
            mode: params.publish_dir_mode,
            pattern: '*_versions.yml'
        ]
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode
        ]
    }

}
