/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run nf-core/magmap -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
    // Prokka peaks around 450MB on these small test genomes, well under the
    // resourceLimits ceiling above -- give it its own tight reservation so
    // more Prokka jobs can run in parallel without starving other processes
    // of memory.
    withName: PROKKA {
        memory = { 2.GB * task.attempt }
    }
}

params {
    config_profile_name        = 'Test profile for duplicate contigs and bakta gff3 compatibility'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Input data
    input       = params.pipelines_testdata_base_path + 'magmap/samplesheets/samplesheet.csv'
    genomeinfo  = params.pipelines_testdata_base_path + 'magmap/testdata/duplicates_genomes.csv'


}
