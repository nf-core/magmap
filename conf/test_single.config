/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test based on a mix of single end and paired sequence reads.

    Use as follows:
        nextflow run nf-core/metatdenovo -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile for mixed single ends and pairs'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Input data
    input          = params.pipelines_testdata_base_path + 'metatdenovo/samplesheet/single.csv'
    genomeinfo     = params.pipelines_testdata_base_path + 'magmap/testdata/genometest.csv'

    // Skip kraken2 classification
    skip_kraken2   = true
}
