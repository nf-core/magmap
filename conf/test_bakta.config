/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run nf-core/magmap -profile test_bakta,<docker/singularity> --outdir <OUTDIR>

    Reuses genomes from both test_metadata (bacterial: GCA_002688505.1) and
    test_species_preference (archaeal: the local_* genomes), but via a genomeinfo file
    that omits genome_gff, so all of them need annotation. Together with
    --annotator bakta_supported_only and gtdb_metadata/gtdbtk_metadata covering both
    domains, this exercises both the Bakta path (Bacteria) and the Prokka fallback path
    (Archaea, which Bakta doesn't support) in the same run.
----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
    withName: PROKKA {
        memory = { 2.GB * task.attempt }
    }
    // The full Bakta database is ~30GB; the light variant (~1.3GB compressed) is the
    // smallest official option and is what nf-core/modules' own bakta tests use too --
    // there is no smaller/custom test database available (see oschwengers/bakta#95).
    withName: BAKTA_BAKTADBDOWNLOAD {
        ext.args = '--type light'
    }
}

params {
    config_profile_name        = 'Test annotator profile'
    config_profile_description = 'Minimal test dataset (bacterial + archaeal genomes lacking a GFF) to check --annotator bakta_supported_only'

    // Input data
    input           = params.pipelines_testdata_base_path + 'magmap/samplesheets/samplesheet.csv'
    genomeinfo      = params.pipelines_testdata_base_path + 'magmap/testdata/bakta_test.genomes.csv'
    gtdb_metadata   = params.pipelines_testdata_base_path + 'magmap/testdata/bac120_metadata.tsv' + ',' + params.pipelines_testdata_base_path + 'magmap/testdata/ar53_metadata.tsv'
    gtdbtk_metadata = params.pipelines_testdata_base_path + 'magmap/testdata/archaeal_duplicates.gtdbtk.tsv'
    features        = 'CDS'

    // Annotator options
    annotator       = 'bakta_supported_only'
    bakta_db        = 'magmap_bakta_db_test'
}
