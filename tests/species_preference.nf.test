            params {
                outdir = "$outputDir"
                species_preference = 'gtdb'
                genomeset_mode = 'sample'
            }
        }

        then {
            def stable_path = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}', 'multiqc/multiqc_plots', 'multiqc/multiqc_plots/**'])
            def stable_content = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            assertAll(
                { assert workflow.success},
                { assert snapshot(
                    workflow.trace.succeeded().size(),
                    removeNextflowVersion("$outputDir/pipeline_info/nf_core_magmap_software_mqc_versions.yml"),
                    stable_path,
                    stable_content,
                    path("${params.outdir}/summary_tables/magmap.overall_stats.tsv.gz").linesGzip.findAll { l -> l.contains('CDS') },
                    path("${params.outdir}/summary_tables/magmap.overall_stats.tsv.gz").linesGzip.size(),
                    path("${params.outdir}/summary_tables/magmap.CDS.counts.tsv.gz").linesGzip.findAll { l -> l.contains('orf') },
                    path("${params.outdir}/summary_tables/magmap.CDS.counts.tsv.gz")
                        .csv(sep: '\t', decompress: true, header: true)
                        .with { table -> [table.columns["accno"], table.columns["sample"]].transpose().collect { row -> row.join("\t") }.toSet().sort() },
                    ['arc00', 'arc01', 'arc02'].collect { s -> path("${params.outdir}/bbmap/${s}.genomes.txt").readLines().sort() },
                    path("${params.outdir}/summary_tables/magmap.genome_metadata.tsv.gz").linesGzip.findAll { l -> l.contains('accno') },
