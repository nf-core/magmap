nextflow_process {

    name "Test Process GFFREAD_PROTEINS"
    script "../main.nf"
    process "GFFREAD_PROTEINS"

    tag "modules"
    tag "modules_local"
    tag "gffread"
    tag "gffread/proteins"

    // CDS without parent, CDS under a gene, and a split CDS under a gene/mRNA pair
    test("inline genome - fna, gff3") {

        when {
            process {
                """
                ch_fna = channel.of(
                    '>c1\\n' +
                    'ATGAAATTTGGGCCCAAATTTGGGTAA' +
                    'ATGCCCGGGAAA' + 'CCC' + 'TTTCCCGGGAAATAA' +
                    'ATGGAAGAAGAAGAAGAAGAAGAATAA\\n'
                ).collectFile(name: 'test.fna')
                ch_gff = channel.of(
                    [
                        '##gff-version 3',
                        'c1\\tx\\tgene\\t1\\t27\\t.\\t+\\t.\\tID=gene-A',
                        'c1\\tx\\tCDS\\t1\\t27\\t.\\t+\\t0\\tID=cds-A;Parent=gene-A',
                        'c1\\tx\\tgene\\t28\\t57\\t.\\t+\\t.\\tID=gene-B',
                        'c1\\tx\\tmRNA\\t28\\t57\\t.\\t+\\t.\\tID=rna-B;Parent=gene-B',
                        'c1\\tx\\tCDS\\t28\\t39\\t.\\t+\\t0\\tID=cds-B;Parent=rna-B',
                        'c1\\tx\\tCDS\\t43\\t57\\t.\\t+\\t0\\tID=cds-B;Parent=rna-B',
                        'c1\\tx\\tCDS\\t58\\t84\\t.\\t+\\t0\\tID=cds-C'
                    ].join('\\n') + '\\n'
                ).collectFile(name: 'test.gff')
                input[0] = ch_fna.combine(ch_gff).map { fna, gff -> [ [ id:'test' ], fna, gff ] }
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert path(process.out.faa[0][1]).linesGzip == [ '>cds-A', 'MKFGPKFG', '>cds-B', 'MPGKFPGK', '>cds-C', 'MEEEEEEE' ] },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }

    }

    test("inline genome - fna, gff3 - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = channel.of('>c1\\nATG\\n').collectFile(name: 'test.fna')
                    .combine(channel.of('##gff-version 3\\n').collectFile(name: 'test.gff'))
                    .map { fna, gff -> [ [ id:'test' ], fna, gff ] }
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }

    }

}
