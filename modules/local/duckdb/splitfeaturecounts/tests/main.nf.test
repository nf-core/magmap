nextflow_process {

    name "Test Process DUCKDB_SPLITFEATURECOUNTS"
    script "../main.nf"
    process "DUCKDB_SPLITFEATURECOUNTS"

    tag "modules"
    tag "modules_local"
    tag "duckdb"
    tag "duckdb/splitfeaturecounts"

    // Inputs are built inline. `counts` has the shape of FEATURECOUNTS output for one sample
    // and all feature types; `ftypes` has the shape of the CATPROKKATSVS orf-to-feature-type
    // mapping. One ORF in `counts` has no `ftypes` entry and must be dropped.

    test("counts are split into one file per feature type, unmapped ORFs dropped") {

        when {
            process {
                """
                def counts = file("\${workDir}/test.featureCounts.tsv")
                counts.text = [
                    ['# Program:featureCounts v2.0.6; Command:"featureCounts" "-g" "ID" "-a" "all.gtf" "-o" "out.tsv" "in.bam"'],
                    ['Geneid', 'Chr', 'Start', 'End', 'Strand', 'Length', 'SAMPLE1.sorted.bam'],
                    ['CDS_1', 'k1', '10', '100', '+', '91', '25'],
                    ['CDS_2', 'k1', '200', '300', '+', '101', '40'],
                    ['TRNA_1', 'k2', '5', '80', '-', '76', '7'],
                    ['UNKNOWN_1', 'k3', '1', '50', '+', '50', '3']
                ].collect { r -> r.join('\\t') }.join('\\n') + '\\n'

                def ftypes = file("\${workDir}/test.orfs.tsv")
                ftypes.text = [
                    ['orf', 'ftype'],
                    ['CDS_1', 'CDS'],
                    ['CDS_2', 'CDS'],
                    ['TRNA_1', 'tRNA']
                ].collect { r -> r.join('\\t') }.join('\\n') + '\\n'

                input[0] = [ [ id:'test', feature: 'CDS,tRNA' ], counts ]
                input[1] = ftypes
                """
            }
        }

        then {
            // Two feature types emit a List<Path>; a single type would emit a Path.
            def outfiles = process.out.counts[0][1]
            def cds   = outfiles.find { f -> f.toString().contains('.CDS.') }
            def trna  = outfiles.find { f -> f.toString().contains('.tRNA.') }
            // Split files start with a comment line before the header, so rows are parsed by hand.
            def parseRows = { f ->
                def lines  = new File(f.toString()).text.readLines().drop(1)
                def header = lines[0].split('\t')
                lines.drop(1).collect { line ->
                    [header, line.split('\t')].transpose().collectEntries { k, v -> [(k): v] }
                }
            }
            def cdsRows  = parseRows(cds)
            def trnaRows = parseRows(trna)
            assertAll(
                { assert process.success },

                { assert outfiles.size() == 2 },

                { assert cdsRows.collect { r -> r["Geneid"] }.sort() == ['CDS_1', 'CDS_2'] },
                { assert trnaRows.collect { r -> r["Geneid"] } == ['TRNA_1'] },

                // UNKNOWN_1 has no ftype entry, so the inner join drops it from every split file.
                { assert (cdsRows + trnaRows).every { r -> r["Geneid"] != 'UNKNOWN_1' } },

                { assert snapshot(process.out.counts).match() }
            )
        }
    }

    test("rows keep their input order for a table larger than one vector") {

        when {
            process {
                """
                def n = 20000
                def counts = file("\${workDir}/many.featureCounts.tsv")
                counts.text = (['# Program:featureCounts', 'Geneid\\tChr\\tStart\\tEnd\\tStrand\\tLength\\tS1.sorted.bam'] +
                    (0..<n).collect { i -> "orf_\${i}\\tk\\t1\\t2\\t+\\t2\\t1" }).join('\\n') + '\\n'

                // ftypes lists the ORFs in reverse order and holds many more unused ORFs than the counts,
                // so a join that follows its own order would reverse the output.
                def ftypes = file("\${workDir}/many.orfs.tsv")
                ftypes.text = (['orf\\tftype'] +
                    ((10 * n - 1)..0).collect { i -> "orf_\${i}\\tCDS" }).join('\\n') + '\\n'

                input[0] = [ [ id:'many', feature: 'CDS' ], counts ]
                input[1] = ftypes
                """
            }
        }

        then {
            def orfs = new File(process.out.counts[0][1].toString()).readLines().drop(2).collect { l -> l.split('\t')[0] }
            assertAll(
                { assert process.success },
                { assert orfs == (0..<20000).collect { i -> "orf_${i}".toString() } }
            )
        }
    }

    test("a sample id containing shell metacharacters doesn't break the script") {

        when {
            process {
                """
                def counts = file("\${workDir}/meta.featureCounts.tsv")
                counts.text = "# Program:featureCounts\\nGeneid\\tChr\\tStart\\tEnd\\tStrand\\tLength\\tS1.sorted.bam\\nCDS_1\\tk1\\t10\\t100\\t+\\t91\\t25\\n"
                def ftypes = file("\${workDir}/meta.orfs.tsv")
                ftypes.text = "orf\\tftype\\nCDS_1\\tCDS\\n"

                input[0] = [ [ id: 'a;b c', feature: 'CDS' ], counts ]
                input[1] = ftypes
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.counts[0][1].toString().endsWith('a;b c.CDS.featureCounts.tsv') },
                { assert new File(process.out.counts[0][1].toString()).readLines().size() == 3 }
            )
        }
    }

    test("a sample id containing a single-quote character doesn't break the generated script") {

        when {
            process {
                """
                // A character code avoids nesting a literal quote in this triple-quoted string.
                def sampleId = "sample" + Character.toString(39) + "x"

                def counts = file("\${workDir}/quote.featureCounts.tsv")
                counts.text = [
                    ['# Program:featureCounts'],
                    ['Geneid', 'Chr', 'Start', 'End', 'Strand', 'Length', "\${sampleId}.sorted.bam"],
                    ['CDS_1', 'k1', '10', '100', '+', '91', '25']
                ].collect { r -> r.join('\\t') }.join('\\n') + '\\n'

                def ftypes = file("\${workDir}/quote.orfs.tsv")
                ftypes.text = [
                    ['orf', 'ftype'],
                    ['CDS_1', 'CDS']
                ].collect { r -> r.join('\\t') }.join('\\n') + '\\n'

                input[0] = [ [ id: sampleId, feature: 'CDS' ], counts ]
                input[1] = ftypes
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.counts[0][1].toString().contains("CDS.featureCounts.tsv") }
            )
        }
    }

    test("a requested feature type with zero matching rows still produces a file, not a crash") {

        when {
            process {
                """
                // No Geneid matches an ftypes entry, so the requested feature type has zero rows
                // and the process must still write a header-only file.
                def counts = file("\${workDir}/nomatch.featureCounts.tsv")
                counts.text = [
                    ['# Program:featureCounts'],
                    ['Geneid', 'Chr', 'Start', 'End', 'Strand', 'Length', 'SAMPLE1.sorted.bam'],
                    ['UNKNOWN_1', 'k1', '1', '50', '+', '50', '3']
                ].collect { r -> r.join('\\t') }.join('\\n') + '\\n'

                def ftypes = file("\${workDir}/nomatch.orfs.tsv")
                ftypes.text = "orf\\tftype\\n"

                input[0] = [ [ id:'test', feature: 'CDS' ], counts ]
                input[1] = ftypes
                """
            }
        }

        then {
            def cdsFile = new File(process.out.counts[0][1].toString())
            assertAll(
                { assert process.success },
                { assert cdsFile.name.contains('.CDS.featureCounts.tsv') },
                { assert cdsFile.readLines().size() == 2 },
            )
        }
    }

    test("a sample id containing a shell metacharacter doesn't break the stub - stub") {

        options "-stub"

        when {
            process {
                """
                def counts = file("\${workDir}/semicolon.featureCounts.tsv")
                counts.text = ''
                def ftypes = file("\${workDir}/semicolon.orfs.tsv")
                ftypes.text = ''

                input[0] = [ [ id: 'sample;rm x' ], counts ]
                input[1] = ftypes
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.counts[0][1].toString().contains('sample;rm x.CDS.featureCounts.tsv') }
            )
        }
    }
}
